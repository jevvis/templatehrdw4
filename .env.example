# Alamat situs setelah deploy (dipakai untuk sitemap, robots, dan Open Graph).
# Salin menjadi .env.local untuk lokal; di Vercel isi di Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://domain-kamu.vercel.app

# Nomor WhatsApp pemilik untuk tombol di form kontak: hanya angka, pakai kode negara (contoh: 628123456789).
# Dikosongkan = WhatsApp terbuka tanpa tujuan, pengunjung memilih kontaknya sendiri.
NEXT_PUBLIC_WHATSAPP_NUMBER=
